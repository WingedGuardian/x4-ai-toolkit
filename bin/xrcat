#!/usr/bin/env bash
# Cross-platform wrapper for Egosoft's XRCatTool (X4 .cat/.dat pack/unpack).
#
#   Windows (Git Bash / MSYS / Cygwin): calls XRCatTool.exe directly (native paths).
#   Linux / macOS:                      runs it through Wine and translates every
#                                       absolute unix path argument to a Wine path
#                                       (Z:\...), because XRCatTool reads a leading
#                                       "/" as a switch and would choke on unix paths.
#
# Configure the tool location via $XRCATTOOL (see x4-paths.env in the toolkit root).
set -uo pipefail

XRCATTOOL="${XRCATTOOL:-XRCatTool.exe}"

# --- Preflight: refuse a pack whose input holds a file XRCatTool would skip -------
# MEASURED (XRCatTool 1.11): an input file whose ABSOLUTE Windows path is 260
# characters or longer (MAX_PATH) is left out of the catalog with only an
# "Illegal file <relative path>" line on stderr, and the tool still exits 0;
# 259 characters pack. So before running the tool, walk every `-in` FOLDER (a
# pack; an `-in` naming a file is an unpack and is not walked) and refuse,
# naming each such path. Off Windows the tool runs under Wine, where a unix path
# is spelt Z:\...; that spelling is what is checked there (not measured under Wine).
# Every file is checked, including any an -include/-exclude filter would drop.
# Length is counted in UTF-16 units, as Windows counts MAX_PATH (MEASURED: with
# e-acute names the cutoff is still 259/260 units). The tool also writes names in
# the system ANSI code page: MEASURED here (code page 1252) a Cyrillic name was
# skipped the same silent way ("Illegal file k?.xml", exit 0) while e-acute and
# the euro sign packed. So any path (the -in root included) that is not encodable
# in this machine's ANSI code page (the registry's ACP) is refused too. INFERRED,
# not measured: other code pages behave the same way for their own repertoire.
# When the code page cannot be read (and under Wine, where it was not measured),
# only ASCII paths pass, and the refusal says why.
_xrcat_is_windows() {
  case "$(uname -s 2>/dev/null)" in MINGW*|MSYS*|CYGWIN*|Windows*) return 0;; esac
  return 1
}
_xrcat_winroot() {
  if _xrcat_is_windows; then cygpath -w -a "$1"; return; fi
  local a; a=$(cd "$1" 2>/dev/null && pwd -P) || return 1
  printf 'Z:%s' "${a//\//\\}"
}
# UTF-16 length of a UTF-8 string, counted byte-wise (no UTF-8 locale needed):
# bytes - continuation bytes + 4-byte sequences (each is a surrogate pair).
_xrcat_u16len() {
  local LC_ALL=C s="$1" cont lead4
  cont="${s//[^$'\x80'-$'\xbf']/}"
  lead4="${s//[^$'\xf0'-$'\xf7']/}"
  echo $(( ${#s} - ${#cont} + ${#lead4} ))
}
# This machine's ANSI code page number, or nothing when it cannot be read.
_xrcat_acp() {
  _xrcat_is_windows || return 0
  MSYS2_ARG_CONV_EXCL='*' reg query 'HKLM\SYSTEM\CurrentControlSet\Control\Nls\CodePage' /v ACP 2>/dev/null \
    | sed -n 's/.*ACP[[:space:]]*REG_SZ[[:space:]]*\([0-9][0-9]*\).*/\1/p' | head -n 1
}
# Why non-ASCII names cannot be checked at all, or nothing when they can.
_xrcat_encoding_problem() {
  local acp="$1"
  if [ -z "$acp" ]; then
    echo "the ANSI code page could not be read (or this is Wine, where it was not measured)"; return
  fi
  if [ "$acp" = "65001" ]; then
    echo "the ANSI code page is 65001 (UTF-8), where XRCatTool's handling of non-ASCII names was not measured"; return
  fi
  if ! command -v iconv >/dev/null 2>&1; then
    echo "iconv is not available to check names against code page $acp"; return
  fi
  if ! printf 'a' | iconv -f UTF-8 -t "CP$acp" >/dev/null 2>&1; then
    echo "this iconv cannot convert to code page $acp"; return
  fi
}
# True when the UTF-8 string cannot be written in code page $2 (ASCII always can).
# $3 non-empty: names cannot be checked, so any non-ASCII byte counts as unwritable.
_xrcat_unencodable() {
  local LC_ALL=C
  case "$1" in *[$'\x80'-$'\xff']*) ;; *) return 1;; esac
  [ -z "$3" ] || return 0
  if printf '%s' "$1" | iconv -f UTF-8 -t "CP$2" >/dev/null 2>&1; then return 1; fi
  return 0
}
_xrcat_preflight() {
  local prev="" a root list rc rel w n u shown=0 acp problem
  local -a long=() odd=()
  acp=$(_xrcat_acp)
  problem=$(_xrcat_encoding_problem "$acp")
  for a in "$@"; do
    if [ "$prev" = "-in" ] && [ -d "$a" ]; then
      root=$(_xrcat_winroot "$a") || { echo "xrcat: REFUSED: cannot resolve the input folder: $a" >&2; return 2; }
      root="${root%\\}"
      list=$(mktemp) || { echo "xrcat: REFUSED: no temp file for the input path check" >&2; return 2; }
      (cd "$a" && find . -type f -print0) > "$list"; rc=$?
      if [ "$rc" -ne 0 ]; then
        rm -f "$list"
        echo "xrcat: REFUSED: could not list every file under $a (find exit $rc); the path-length check would be incomplete" >&2
        return 2
      fi
      while IFS= read -r -d '' rel; do
        rel="${rel#./}"; w="$root\\${rel//\//\\}"
        u=$(_xrcat_u16len "$w")
        if [ "$u" -ge 260 ]; then long+=("$u  $w"); fi
        if _xrcat_unencodable "$w" "$acp" "$problem"; then odd+=("$w"); fi
      done < "$list"
      rm -f "$list"
    fi
    prev="$a"
  done
  if [ "${#odd[@]}" -gt 0 ]; then
    if [ -z "$problem" ]; then
      echo "xrcat: REFUSED: ${#odd[@]} input path(s) cannot be written in this machine's ANSI code page ($acp)." >&2
    else
      echo "xrcat: REFUSED: ${#odd[@]} input path(s) hold non-ASCII characters, and $problem." >&2
    fi
    echo "xrcat: XRCatTool 1.11 writes names in the ANSI code page and leaves a name it cannot write out of the catalog, still exiting 0. Rename them (or the input folder)." >&2
    for w in "${odd[@]:0:50}"; do echo "xrcat:   $w" >&2; done
    [ "${#odd[@]}" -gt 50 ] && echo "xrcat:   ... and $(( ${#odd[@]} - 50 )) more" >&2
    return 3
  fi
  n=${#long[@]}
  [ "$n" -eq 0 ] && return 0
  echo "xrcat: REFUSED: $n input file(s) have an absolute path of 260 or more UTF-16 units (Windows MAX_PATH)." >&2
  echo "xrcat: XRCatTool 1.11 leaves such a file out of the catalog and still exits 0. Stage the mod under a shorter folder and pack again." >&2
  for w in "${long[@]}"; do
    if [ "$shown" -ge 50 ]; then echo "xrcat:   ... and $((n - shown)) more" >&2; break; fi
    echo "xrcat:   $w" >&2; shown=$((shown + 1))
  done
  return 3
}
# Sourced (by the tests, to call the functions above), stop here: nothing below runs and
# no environment variable can change what an executed xrcat checks.
if [ "${BASH_SOURCE[0]}" != "$0" ]; then return 0; fi
_xrcat_preflight "$@" || exit $?

case "$(uname -s 2>/dev/null)" in
  MINGW*|MSYS*|CYGWIN*|Windows*)            # Windows shells: run the exe as-is
    if [ ! -f "$XRCATTOOL" ] && ! command -v "$XRCATTOOL" >/dev/null 2>&1; then
      echo "xrcat: XRCatTool not found at: $XRCATTOOL (set \$XRCATTOOL in x4-paths.env)" >&2
      exit 1
    fi
    exec "$XRCATTOOL" "$@"
    ;;
  *)                                        # Linux / macOS: Wine + path translation
    command -v wine >/dev/null 2>&1 || { echo "xrcat: 'wine' not found (needed to run XRCatTool on this OS)" >&2; exit 1; }
    [ -f "$XRCATTOOL" ] || { echo "xrcat: XRCatTool not found at: $XRCATTOOL (set \$XRCATTOOL)" >&2; exit 1; }
    args=()
    for a in "$@"; do
      if [[ "$a" == /* ]]; then
        args+=( "$(winepath -w "$a" 2>/dev/null || echo "$a")" )
      else
        args+=( "$a" )
      fi
    done
    WINEDEBUG="${WINEDEBUG:--all}" exec wine "$XRCATTOOL" "${args[@]}"
    ;;
esac
